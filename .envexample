# ---------------------------------------------------------------------------
# AuthePay environment variables.
# Copy this file to .env (or .env.local for local dev) and fill in real
# values. NEVER commit .env or any file containing real secrets.
# All values shown here are placeholders only.
# ---------------------------------------------------------------------------

# --- Public client keys (safe for the browser) -----------------------------
# Supabase project URL and anon (publishable) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public URL of this app (used for redirects/callbacks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only secrets (never exposed to the browser) ---------------------
# Supabase service-role key. Used ONLY by server-side API routes to invoke
# atomic, security-definer Postgres functions for financial operations.
# Migrations 010/011 revoke PUBLIC execute on money RPCs and grant EXECUTE to
# the service role only. Rotate immediately if leaked (see SECURITY.md).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Payment provider configuration -----------------------------------------
# One of: test | orange_money_bw | myzaka | smega | bank_transfer
PAYMENT_PROVIDER=test

# When "true", the isolated test provider is enabled. Real providers refuse to
# run unless their own credentials are configured (never commit credentials).
PAYMENT_TEST_MODE=true

# Provider credentials are defined per-provider by each integration and must
# never be committed. Examples (do not commit real values):
# ORANGE_MONEY_BW_API_KEY=
# MYZAKA_API_KEY=
# SMEGA_API_KEY=
# BANK_TRANSFER_CLIENT_ID=
# BANK_TRANSFER_CLIENT_SECRET=